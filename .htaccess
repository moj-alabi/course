# ---------------------------------------------------------------
# SLCA Course - Apache Configuration
# Place this file in /var/www/html/ alongside the course files
# ---------------------------------------------------------------

# Correct MIME types
AddType text/html .html
AddType text/css .css
AddType image/png .png
AddType image/svg+xml .svg

# Default document
DirectoryIndex index.html

# Cache static assets for 7 days, recheck HTML every time
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType image/png "access plus 7 days"
  ExpiresByType image/svg+xml "access plus 7 days"
</IfModule>

# Cache-Control headers
<IfModule mod_headers.c>
  <FilesMatch "\.(css|png|svg)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# Gzip compression (faster page loads)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css
</IfModule>

# Custom 404 - sends the student back to the course index
ErrorDocument 404 /index.html

# Block access to the build/ directory
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^build/ - [F,L]
</IfModule>

# Security headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
